{
  "name": "stage-clock",
  "productName": "Stage Clock",
  "version": "1.4.1",
  "description": "Event countdown timer with a rundown, wrap-up colors and a fullscreen speaker display.",
  "homepage": "https://github.com/David-Uka/stage-clock",
  "author": "David Uka",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node sync.js",
    "start": "npm run sync && electron .",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.davidu.stageclock",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "afterSign.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "app/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}"
    },
    "mac": {
      "icon": "app/icon-512.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "icon": "app/icon-512.png",
      "category": "Utility"
    },
    "afterSign": "afterSign.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
